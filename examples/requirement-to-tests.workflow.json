{
  "id": "requirement-to-tests",
  "version": "1.0.0",
  "name": "需求拆解并生成测试用例",
  "steps": [
    {
      "id": "decompose",
      "skill": "requirement.decompose",
      "input": {
        "requirement": {"$ref": "input.requirement"}
      }
    },
    {
      "id": "generate-tests",
      "skill": "test.case.generate",

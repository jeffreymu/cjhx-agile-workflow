{
  "name": "cjhx-agile-workflow",
  "version": "0.6.0",
  "description": "TypeScript-first, skill-driven Agentic SDLC framework",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "cjhx": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/ui",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "ui": "npm run build && node dist/src/cli.js ui"
  },
  "keywords": [
    "agentic-sdlc",
    "skills",
    "workflow",
    "devops"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
